{
  "name": "webmcp-a11ysync-monorepo",
  "version": "0.1.0",
  "private": true,
  "description": "The Bi-Directional Accessibility Runtime & Sensory Bridge for WebMCP",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "turbo build",
    "dev": "turbo dev",
    "lint": "turbo lint",
    "test": "turbo test",
    "type-check": "turbo type-check",
    "clean": "turbo clean && rm -rf node_modules",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\""
  },
  "devDependencies": {
    "prettier": "^3.5.3",
    "turbo": "^2.4.4",
    "typescript": "^5.8.2",
    "typescript-eslint": "^8.69.0",
    "vitest": "^3.0.7"
  },
  "packageManager": "bun@1.3.14"
}
